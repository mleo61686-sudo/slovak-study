{
  "[\"cs\",\"Eva\",\"Kolegyně říká, že klíče v práci nejsou. Podívám se ještě do malé kapsy v tašce. Aha, jsou tady!\"]": "/audio/flunio-voice/cs/da53cd4a1db5375d044c3580.mp3",
  "[\"cs\",\"Eva\",\"Otevřela jsem tašku a našla jsem klíče v malé kapse. To je úleva!\"]": "/audio/flunio-voice/cs/4086ddfa4e1c9a8fce944e2f.mp3",
  "[\"cs\",\"Kolega\",\"Ahoj, Petro. Potřeboval bych si s tebou vyměnit páteční směnu. Mám důležitou schůzku na úřadě.\"]": "/audio/flunio-voice/cs/bbc4546f1ca2c0300b8cea63.mp3",
  "[\"cs\",\"Kolega\",\"Ano, počet hodin zůstane stejný. Vedoucímu ale musíme změnu ještě dnes potvrdit.\"]": "/audio/flunio-voice/cs/a4438a0fd522ac4ab93dd6d7.mp3",
  "[\"cs\",\"Kolega\",\"Vedoucí s výměnou souhlasí, pokud oba potvrdíme nový rozpis ještě dnes.\"]": "/audio/flunio-voice/cs/4fa0ef264ea7a608061c364c.mp3",
  "[\"cs\",\"Petr\",\"Takže v pátek přijdu ráno a v pondělí skončím do tří. Jakmile bude rozpis potvrzený, napíšu ti.\"]": "/audio/flunio-voice/cs/32a421008fa05c135d2aca38.mp3",
  "[\"cs\",\"Petr\",\"V pátek můžu přijít ráno, ale v pondělí potřebuji skončit nejpozději ve tři.\"]": "/audio/flunio-voice/cs/d3c2b75d5f0ca7d1d1b3e7fe.mp3",
  "[\"cs\",\"Prodavačka\",\"Dobře, bude to dvacet korun.\"]": "/audio/flunio-voice/cs/7429152a65e12243165ad57f.mp3",
  "[\"cs\",\"Prodavačka\",\"Dobře, přiložte kartu.\"]": "/audio/flunio-voice/cs/3b487745b5d3c60f6e17d445.mp3",
  "[\"cs\",\"Prodavačka\",\"Dobrý den! Co si přejete?\"]": "/audio/flunio-voice/cs/22e1ffa072604b911d8861e5.mp3",
  "[\"cs\",\"Prodavačka\",\"Samozřejmě, tady máte.\"]": "/audio/flunio-voice/cs/d1eaf181ffc5f7a322c5818f.mp3",
  "[\"cs\",\"Prodavačka\",\"Stojí to dvacet korun. Budete platit kartou?\"]": "/audio/flunio-voice/cs/c37a03510974f2cc5aecbf88.mp3",
  "[\"cs\",\"Prodavačka\",\"Tady máte. Ještě něco?\"]": "/audio/flunio-voice/cs/c4bd99b44194670c20b3f113.mp3",
  "[\"cs\",\"Prodavačka\",\"Tak dobře. Na shledanou!\"]": "/audio/flunio-voice/cs/5a36488901b7dcb67fb839ff.mp3",
  "[\"cs\",\"Recepční\",\"Ano, v devět hodin. Vyhovuje vám to?\"]": "/audio/flunio-voice/cs/3830ef86a322d6a71c406be3.mp3",
  "[\"cs\",\"Recepční\",\"Co vás trápí?\"]": "/audio/flunio-voice/cs/e19e55697658d5bf1b118d68.mp3",
  "[\"cs\",\"Recepční\",\"Dobrý den, ordinace doktorky Novotné. Jak vám mohu pomoci?\"]": "/audio/flunio-voice/cs/04213eed4455ffe492dc52b2.mp3",
  "[\"cs\",\"Recepční\",\"Na shledanou.\"]": "/audio/flunio-voice/cs/6d1340d30672bebb35624c96.mp3",
  "[\"cs\",\"Recepční\",\"Rozumím. Máme volno zítra ráno.\"]": "/audio/flunio-voice/cs/17e6961d4f7eb8cff03f5daf.mp3",
  "[\"cs\",\"Recepční\",\"Výborně, těšíme se na vás.\"]": "/audio/flunio-voice/cs/fa586afff75fb979a49d147f.mp3",
  "[\"cs\",\"Soused\",\"Dobrý večer, Evo. Potřebujete pomoc? Možná jste klíče nechala v práci.\"]": "/audio/flunio-voice/cs/fa511f58fb164818122534c2.mp3",
  "[\"cs\",\"Soused\",\"Tak to dobře dopadlo. Příště si je dejte na stejné místo.\"]": "/audio/flunio-voice/cs/f75fe2979a414eb7b839ad94.mp3",
  "[\"cs\",\"Sousedka\",\"Proti opravě nic nemám. Jen bych ocenila, kdybychom se o termínu dozvěděli aspoň několik dní předem. Ne každý může zůstat doma bez přípravy.\"]": "/audio/flunio-voice/cs/383143cf62f4058e574a9a72.mp3",
  "[\"cs\",\"Správce\",\"Klíče může převzít pověřená osoba, pokud s tím vlastník souhlasí. Podmínky vám pošleme písemně.\"]": "/audio/flunio-voice/cs/bcbe463f935a82c08839799d.mp3",
  "[\"cs\",\"Správce\",\"Předběžný termín rozešleme e-mailem. Jakmile ho dodavatel potvrdí, zveřejníme přesný harmonogram i pokyny pro zpřístupnění bytů.\"]": "/audio/flunio-voice/cs/dceb973446b09be365e585c8.mp3",
  "[\"cs\",\"Správce\",\"Uděláme maximum, abychom termín oznámili včas. Dokud ale firma neodpoví, nemohu slíbit konkrétní počet dní.\"]": "/audio/flunio-voice/cs/42cdf0754f781e9a7d6a8024.mp3",
  "[\"cs\",\"Správce\",\"Výměna stoupaček je nutná. Práce by měly trvat dva dny, přesný termín však firma dosud nepotvrdila.\"]": "/audio/flunio-voice/cs/f1eb9be89308d1c0636be3bf.mp3",
  "[\"cs\",\"Vedoucí\",\"Díky za domluvu.\"]": "/audio/flunio-voice/cs/4b72d30470cbb764daae70b9.mp3",
  "[\"cs\",\"Vedoucí\",\"Dobře, to by šlo.\"]": "/audio/flunio-voice/cs/ce85b1471110fb961f57dc88.mp3",
  "[\"cs\",\"Vedoucí\",\"Rozumím. V kolik můžeš dorazit?\"]": "/audio/flunio-voice/cs/b240b77d36ba3b6a9c7baa29.mp3",
  "[\"cs\",\"Vedoucí\",\"Skvělé.\"]": "/audio/flunio-voice/cs/f77d7cc4aac3b6822fdc5786.mp3",
  "[\"cs\",\"Vedoucí\",\"V kolik tedy můžeš dorazit?\"]": "/audio/flunio-voice/cs/272e9edbcfe3b94ebd6e7538.mp3",
  "[\"cs\",\"Vedoucí\",\"Vybavení připraví ranní směna. Ty prosím zkontroluj seznam úkolů.\"]": "/audio/flunio-voice/cs/9318204d4621227c7bddf831.mp3",
  "[\"cs\",\"Vedoucí\",\"Zítra potřebujeme dokončit zakázku dřív. Můžeš přijít už v šest?\"]": "/audio/flunio-voice/cs/8df49cc79bfd4e29e210fe7b.mp3",
  "[\"cs\",\"Vypravěč\",\"Eva se vrací z práce. Stojí před domem a hledá klíče, ale nemůže je najít.\"]": "/audio/flunio-voice/cs/5dfdde00d76fe926c538d924.mp3",
  "[\"pl\",\"Kasia\",\"Koleżanka mówi, że kluczy nie ma w pracy. Sprawdzę jeszcze małą kieszeń torby. O, są tutaj!\"]": "/audio/flunio-voice/pl/112236572fb3694b86c5b049.mp3",
  "[\"pl\",\"Kasia\",\"Otworzyłam torbę i znalazłam klucze w małej kieszeni. Co za ulga!\"]": "/audio/flunio-voice/pl/bda757bb5350d0e5c737b7ff.mp3",
  "[\"pl\",\"Kierownik\",\"Dobrze, tak się umówmy.\"]": "/audio/flunio-voice/pl/3da09b989a46c8e8e5d930ca.mp3",
  "[\"pl\",\"Kierownik\",\"Dobrze.\"]": "/audio/flunio-voice/pl/87f103bc8ed9d8cc6b1ee7b4.mp3",
  "[\"pl\",\"Kierownik\",\"Dziękuję za ustalenia.\"]": "/audio/flunio-voice/pl/8c203acc43f5c22996d7821e.mp3",
  "[\"pl\",\"Kierownik\",\"Jutro musimy zacząć wcześniej. Możesz przyjść na szóstą?\"]": "/audio/flunio-voice/pl/224b2721657944deb3ebd07b.mp3",
  "[\"pl\",\"Kierownik\",\"O której możesz być w pracy?\"]": "/audio/flunio-voice/pl/819662066869e11e96f0b84f.mp3",
  "[\"pl\",\"Kierownik\",\"Rozumiem. O której możesz być?\"]": "/audio/flunio-voice/pl/b35eb44dde369d02b86e0f7e.mp3",
  "[\"pl\",\"Kierownik\",\"Sprzęt przygotuje poranna zmiana. Ty sprawdź listę zadań.\"]": "/audio/flunio-voice/pl/441e6d3c689fb37018355a56.mp3",
  "[\"pl\",\"Kolega\",\"Cześć, Piotrze. Czy możemy zamienić się zmianami w piątek? Mam ważną wizytę w urzędzie.\"]": "/audio/flunio-voice/pl/2ee0a7d5e33baa21ed6ac801.mp3",
  "[\"pl\",\"Kolega\",\"Kierownik nie ma nic przeciwko, jeśli obaj potwierdzimy nowy grafik jeszcze dzisiaj.\"]": "/audio/flunio-voice/pl/9389f9bcd437d3d9acae8a67.mp3",
  "[\"pl\",\"Kolega\",\"Tak, liczba godzin będzie taka sama. Musimy jednak jeszcze dzisiaj potwierdzić zmianę u kierownika.\"]": "/audio/flunio-voice/pl/0dccc0b4ecfe5e6f43760e83.mp3",
  "[\"pl\",\"Narrator\",\"Kasia wraca z pracy. Stoi przed drzwiami i szuka kluczy, ale nie może ich znaleźć.\"]": "/audio/flunio-voice/pl/3276c8cfee96eb774ce889c9.mp3",
  "[\"pl\",\"Piotr\",\"Czyli w piątek przyjdę rano, a w poniedziałek wyjdę do piętnastej. Napisz do mnie, gdy grafik będzie zatwierdzony.\"]": "/audio/flunio-voice/pl/a02e3240da9b7d6753ea6d63.mp3",
  "[\"pl\",\"Piotr\",\"W piątek mogę pracować rano, ale w poniedziałek muszę wyjść najpóźniej o piętnastej.\"]": "/audio/flunio-voice/pl/d50e8cd47c9235c6b78d40cc.mp3",
  "[\"pl\",\"Rejestratorka\",\"Co panu dolega?\"]": "/audio/flunio-voice/pl/fdca2e19643507067e724c62.mp3",
  "[\"pl\",\"Rejestratorka\",\"Do widzenia!\"]": "/audio/flunio-voice/pl/d7e667fb7fa68c912704291a.mp3",
  "[\"pl\",\"Rejestratorka\",\"Dzień dobry, przychodnia. W czym mogę pomóc?\"]": "/audio/flunio-voice/pl/d39c32f4648573191d928da6.mp3",
  "[\"pl\",\"Rejestratorka\",\"Proszę przyjść kilka minut wcześniej.\"]": "/audio/flunio-voice/pl/51216d6f1f11ceb25b757831.mp3",
  "[\"pl\",\"Rejestratorka\",\"Rozumiem. Mamy termin jutro rano.\"]": "/audio/flunio-voice/pl/20cf248fdd049e28c79b39fc.mp3",
  "[\"pl\",\"Rejestratorka\",\"Tak, o dziewiątej. Czy ta godzina panu odpowiada?\"]": "/audio/flunio-voice/pl/67c42069eb0c52dd62584c5d.mp3",
  "[\"pl\",\"Sąsiad\",\"Dobry wieczór, Kasiu. Co się stało? Może zostawiłaś klucze w pracy?\"]": "/audio/flunio-voice/pl/d6dead76488fc36d6635948d.mp3",
  "[\"pl\",\"Sąsiad\",\"Dobrze, że się znalazły. Następnym razem odkładaj klucze w to samo miejsce.\"]": "/audio/flunio-voice/pl/4457fc5cad039ffb67f0239b.mp3",
  "[\"pl\",\"Sąsiadka\",\"Nie kwestionuję potrzeby remontu. Wolałabym jednak, żebyśmy poznali termin z kilkudniowym wyprzedzeniem. Nie każdy może zorganizować sobie wolne z dnia na dzień.\"]": "/audio/flunio-voice/pl/22bcea2cfead833a743151f9.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Dobrze, razem pięć złotych.\"]": "/audio/flunio-voice/pl/db88edc2dfc11023771232c5.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Dziękuję, do widzenia!\"]": "/audio/flunio-voice/pl/f7a64f834cca21b3d0e7ea8b.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Dzień dobry! W czym mogę pomóc?\"]": "/audio/flunio-voice/pl/09e56ba0b3c3295d019d9370.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Oczywiście, proszę bardzo.\"]": "/audio/flunio-voice/pl/9493ccb6249a7d7ebd6da198.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Proszę bardzo. Coś jeszcze?\"]": "/audio/flunio-voice/pl/b72162162f844d8d51b39d74.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"Proszę przyłożyć kartę.\"]": "/audio/flunio-voice/pl/3ee85e9d60a07102d209558c.mp3",
  "[\"pl\",\"Sprzedawczyni\",\"To kosztuje pięć złotych. Płaci pan kartą?\"]": "/audio/flunio-voice/pl/33ae92e473383425617a8cf8.mp3",
  "[\"pl\",\"Zarządca\",\"Jeszcze dziś prześlemy wstępny termin. Po jego potwierdzeniu opublikujemy dokładny harmonogram oraz zasady dostępu do mieszkań.\"]": "/audio/flunio-voice/pl/76be04c82d26e14ad212db2f.mp3",
  "[\"pl\",\"Zarządca\",\"Można upoważnić inną osobę do udostępnienia mieszkania, ale potrzebna jest zgoda właściciela. Szczegóły wyślemy na piśmie.\"]": "/audio/flunio-voice/pl/e8f9612b2e4d89b40fa9e7e1.mp3",
  "[\"pl\",\"Zarządca\",\"Postaramy się przekazać wiadomość jak najwcześniej. Nie mogę jednak obiecać trzech dni, dopóki wykonawca nie potwierdzi terminu.\"]": "/audio/flunio-voice/pl/1015b88df25e4cd57eb95138.mp3",
  "[\"pl\",\"Zarządca\",\"Wymiana pionów instalacyjnych jest konieczna. Prace powinny potrwać dwa dni, ale wykonawca nie potwierdził jeszcze terminu.\"]": "/audio/flunio-voice/pl/f4355bd5477ff4951a28bc1d.mp3",
  "[\"sk\",\"Kolega (telefonát)\",\"Ahoj, Martin. Tvoje kľúče som v práci nevidel. Pozri sa ešte do tašky.\"]": "/audio/flunio-voice/sk/1dcabbfbe697f6b013a57520.mp3",
  "[\"sk\",\"Kolega\",\"Ahoj, prečo stojí linka? Stalo sa niečo?\"]": "/audio/flunio-voice/sk/67d24b50ede7377344c9aafe.mp3",
  "[\"sk\",\"Kolega\",\"Dobre, radšej zavoláme údržbu.\"]": "/audio/flunio-voice/sk/332cd1f0459f85a26af6fcbe.mp3",
  "[\"sk\",\"Kolega\",\"Môžem prísť o hodinu skôr, ale potom potrebujem odísť načas. Večer mám už dohodnutý program.\"]": "/audio/flunio-voice/sk/c2b262643f3efbe40145b407.mp3",
  "[\"sk\",\"Kolega\",\"Rozumiem. Technik sa na to príde pozrieť.\"]": "/audio/flunio-voice/sk/01da3f8922e165056daea776.mp3",
  "[\"sk\",\"Kolega\",\"Súhlasím, zavolám údržbu.\"]": "/audio/flunio-voice/sk/5e10f24867e7568f524f6921.mp3",
  "[\"sk\",\"Kolega\",\"Technik sa pýta, ako často sa to stáva.\"]": "/audio/flunio-voice/sk/c06570d2247444d3b6610ef4.mp3",
  "[\"sk\",\"Kolega\",\"Vieš, čo sa pokazilo?\"]": "/audio/flunio-voice/sk/be8311b44f734cbb05881f34.mp3",
  "[\"sk\",\"Martin\",\"Ďakujem za pomoc. Nabudúce si ich dám do jedného vrecka.\"]": "/audio/flunio-voice/sk/696763fc4a19daad52e592a4.mp3",
  "[\"sk\",\"Predavačka\",\"Ďakujem, dovidenia!\"]": "/audio/flunio-voice/sk/3c308be0da24e3c93afe36cf.mp3",
  "[\"sk\",\"Predavačka\",\"Dobre, sú to dve eurá.\"]": "/audio/flunio-voice/sk/82026031c3d46f1bcdb64275.mp3",
  "[\"sk\",\"Predavačka\",\"Dobrý deň! Čo si prosíte?\"]": "/audio/flunio-voice/sk/cd2dd6dc58efdac14862db30.mp3",
  "[\"sk\",\"Predavačka\",\"Nech sa páči. Ešte niečo?\"]": "/audio/flunio-voice/sk/d9653f771b6c427295e20568.mp3",
  "[\"sk\",\"Predavačka\",\"Samozrejme, nech sa páči.\"]": "/audio/flunio-voice/sk/5ed850fdc5c7aa1f9a50dc55.mp3",
  "[\"sk\",\"Predavačka\",\"Stojí to dve eurá. Budete platiť kartou?\"]": "/audio/flunio-voice/sk/0be33e0b17182ed94feddf75.mp3",
  "[\"sk\",\"Predavačka\",\"Výborne, dovidenia!\"]": "/audio/flunio-voice/sk/d150141121e462a89691619b.mp3",
  "[\"sk\",\"Recepcia\",\"Áno, o deviatej. Vyhovuje vám to?\"]": "/audio/flunio-voice/sk/ef58ee82690d2158ae92af33.mp3",
  "[\"sk\",\"Recepcia\",\"Čo vás trápi?\"]": "/audio/flunio-voice/sk/b00b007ff70bcb914d12726a.mp3",
  "[\"sk\",\"Recepcia\",\"Dobre, dovidenia zajtra.\"]": "/audio/flunio-voice/sk/3d60adbaa6b7f2c9656014f2.mp3",
  "[\"sk\",\"Recepcia\",\"Dobre, tešíme sa na vás zajtra.\"]": "/audio/flunio-voice/sk/8cbdc24a920996120b3f749e.mp3",
  "[\"sk\",\"Recepcia\",\"Dobrý deň, ambulancia doktorky Novákovej. Ako vám môžem pomôcť?\"]": "/audio/flunio-voice/sk/14b9b2fa43d93aefe40ae1dc.mp3",
  "[\"sk\",\"Recepcia\",\"Rozumiem. Máme termín zajtra ráno.\"]": "/audio/flunio-voice/sk/d241b29a942dd59dae6b4166.mp3",
  "[\"sk\",\"Recepcia\",\"Samozrejme. Čo vás trápi?\"]": "/audio/flunio-voice/sk/2eb23c4dea6339b401c10a05.mp3",
  "[\"sk\",\"Rozprávač\",\"Martin otvorí tašku. Kľúče sú na dne pod fľašou vody. Konečne môže ísť domov.\"]": "/audio/flunio-voice/sk/50cc9f44e71686593efe678a.mp3",
  "[\"sk\",\"Rozprávač\",\"Martin prišiel domov po práci. Pred dverami hľadá kľúče vo vreckách, ale nikde ich nemá.\"]": "/audio/flunio-voice/sk/3efdc96ca49d56fd4420ff13.mp3",
  "[\"sk\",\"Správca domu\",\"Je to možné, ak s tým vlastník súhlasí a vopred určí, kto byt sprístupní. Podrobnosti vám pošleme písomne.\"]": "/audio/flunio-voice/sk/c4125489124932ebe5368959.mp3",
  "[\"sk\",\"Správca domu\",\"Pokúsime sa oznámiť termín čo najskôr. Tri dni však neviem zaručiť, kým nemáme potvrdenie od firmy.\"]": "/audio/flunio-voice/sk/2a3de93169aa37415ec50e76.mp3",
  "[\"sk\",\"Správca domu\",\"Pošleme vám predbežný termín ešte dnes. Keď ho firma potvrdí, dáme vedieť aj o tom, ako zabezpečiť prístup do bytov. Zároveň prosíme, aby ste nám zmeny nahlásili včas.\"]": "/audio/flunio-voice/sk/b44a89d9722e0cc55017d6b1.mp3",
  "[\"sk\",\"Správca domu\",\"Výmena stúpačiek je nevyhnutná. Práce by mali trvať dva dni, no presný harmonogram dostanete až po potvrdení od dodávateľa.\"]": "/audio/flunio-voice/sk/666f8fb67a8e8c582c7b7d19.mp3",
  "[\"sk\",\"Suseda\",\"Rozumiem, že opravu nemožno odkladať. Bolo by však dobré, keby sme sa o termíne dozvedeli skôr než deň vopred. Nie každý si môže vziať voľno na poslednú chvíľu.\"]": "/audio/flunio-voice/sk/5480f99308d1260896640823.mp3",
  "[\"sk\",\"Susedka\",\"Dobrý večer, Martin. Vyzeráš unavene. Stalo sa niečo?\"]": "/audio/flunio-voice/sk/633552fedcd54b0404bbd047.mp3",
  "[\"sk\",\"Susedka\",\"Jasné. Skús sa pozrieť do tašky. Niekedy tam kľúče zapadnú.\"]": "/audio/flunio-voice/sk/d28a22183b5517fed8de6c08.mp3",
  "[\"sk\",\"Vedúca\",\"Dobrý nápad. Ty pripravíš stroje, ja skontrolujem odtok a ostatní dokončia podlahu.\"]": "/audio/flunio-voice/sk/3a04b128350c81a41a4d5e65.mp3",
  "[\"sk\",\"Vedúca\",\"Dohodnuté. Ak narazíte na problém, dajte mi hneď vedieť. Nechcem, aby ste sa zbytočne ponáhľali.\"]": "/audio/flunio-voice/sk/776f2b1ac561e878b946c8b6.mp3",
  "[\"sk\",\"Vedúca\",\"Najprv musí byť čistá linka. Podlahu môžeme dokončiť potom, ak zostane čas.\"]": "/audio/flunio-voice/sk/2df8e37dbe9992d0b5a3b923.mp3",
  "[\"sk\",\"Vedúca\",\"V piatok potrebujeme dokončiť čistenie linky skôr. Kolega ochorel a na poobednej zmene budeme iba traja.\"]": "/audio/flunio-voice/sk/720b49cd61523e46bd1949e3.mp3"
}
